---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import LinkedInIcon from '../icons/LinkedIn.astro';
import SocialPill from '../components/SocialPill.astro';
import GitHubIcon from '../icons/GitHub.astro';
import MailIcon from '../icons/Mail.astro';
import Experience from '../components/Experience.astro';
import Section from '../components/Section.astro';
import SuitCase from '../icons/SuitCase.astro';
import CVIcon from '../icons/CV.astro';
import CodeIcon from '../icons/Code.astro';
import Projects from '../components/Projects.astro';
---

<Layout 
  title="PortFolio de Matías - FrontEnd Dev + Variedad"
  description="Contratame, soy chill, hago muchas cosas. A veces, soy crítico culinario :)"
>
    
    <!-- El main como contenedor central -->
    <main class="px-4">
        
        <!-- SECCIÓN 1: Presentación Personal -->
        <Section class="py-44 pb-32">
            <div class="flex flex-col-reverse lg:flex-row items-center justify-between gap-10 text-center lg:text-left">
                
                <div class="flex-1"> 
                    <h1 class="text-white text-3xl md: text-4xl lg:text-5xl font-bold flex flex-wrap gap-x-4 pb-6 lg:pb-3">
                        Hola,soy Matias. 
                        <a class="text-xs sm:text-sm mt-3" href="https://www.linkedin.com/in/matias-alcal%C3%A1/" target="_blank" rel="noopener noreferrer">
                            <Badge>Disponible para trabajar</Badge>
                        </a>
                    </h1> 
                    
                    <h2 class="text-xl lg:text-s justify-center items-center max-w-[900px] text-gray-200">
                        Estudiante de Ingeniería de Software | Lima, Perú 🇵🇪. 
                        Interesado en la automatización, análisis de datos y creación de software con 
                        <span class="text-amber-200 font-semibold"> valor real.</span>
                    </h2>

                    <nav class="flex gap-3 mt-3 flex-wrap">
                        <SocialPill href="https://www.linkedin.com/in/matias-alcal%C3%A1/">
                            <LinkedInIcon class="size-4 md:size-5"/> LinkedIn
                        </SocialPill>
                        <SocialPill href="https://github.com/Matheuu17">
                            <GitHubIcon class="size-4 md:size-5"/> GitHub
                        </SocialPill>
                        <SocialPill href="/CV-MAB.pdf" rel="noopener noreferrer" target="_blank">
                            <CVIcon class="size-4 md:size-5"/> CV
                        </SocialPill>
                        <SocialPill href="mailto:matiasalcala123456@gmail.com">
                            <MailIcon class="size-4 md:size-5"/> matiasalcala123456@gmail.com
                        </SocialPill>
                    </nav>
                </div>  
                <img  
                    class="rounded-full w-80 h-80 lg:w-96 lg:h-96 object-cover shadow-lg border border-white/10 flex-shrink-0" 
                    src="/mat.JPG" 
                    alt="Matías Alcalá Photo"
                />
            </div>  
        </Section>

        <!-- SECCIÓN 2: Experiencia -->
        <Section id="Experience" class="py-16 sm:py-14">
            <h2 class="text-4xl sm:text-2xl font-bold mb-6 flex items-center gap-x-3 text-white">
                <SuitCase class="size-4 sm:size-5"/>
                Experiencia
            </h2>
            <Experience/>
        </Section> 

        <!-- SECCIÓN 3: Proyectos -->
        <Section id="Projects" class="py-16 sm:py-14">
            <h2 class="text-4xl sm:text-2xl font-bold mb-6 flex items-center gap-x-3 text-white">
                <CodeIcon class="size-4 sm:size-5"/>
                Proyectos
            </h2>
            <Projects />
        </Section> 
        
    </main>
</Layout>