---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";

// Secciones modulares
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Intereses from "../components/Intereses.astro";
import Contacto from "../components/Contacto.astro";
---

<Layout
  title="Matías Alcalá — Software & Backend Engineer Jr"
  description="Estudiante de Ingeniería de Software enfocado en desarrollo backend con Python (Django), APIs y modelado de datos."
>
  <!-- SECCIÓN 1: HERO (Oscuro) -->
  <Hero />

  <!-- SECCIÓN 2: SOBRE MÍ (Contraste Claro #F4F7F9) -->
  <About />

  <!-- SECCIÓN 2: EXPERIENCIA (Contraste Claro #F4F7F9)
  <Section id="Experiencia" theme="light" class="py-20 sm:py-28">
    <div class="mb-12">
      <span class="block font-mono text-xs uppercase tracking-widest text-[#0E7490] font-semibold mb-2">
        01 // TRAYECTORIA
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold uppercase tracking-tight text-[#0B1120]">
        Experiencia
      </h2>
    </div>
    <Experience />
  </Section>-->

  <!-- SECCIÓN 3: SKILLS (Oscuro) -->
  <Section id="Skills" theme="dark" class="py-20 sm:py-28">
    <div class="mb-12">
      <h2 class="font-display text-6xl sm:text-7xl lg:text-[5.5rem] font-bold uppercase tracking-tight leading-[0.9] text-[#F8FAFC]">
        Skills &amp; Stack
      </h2>
    </div>
    <Skills />
  </Section>

  <!-- SECCIÓN 4: PROYECTOS (Oscuro) -->
  <Section
    id="Proyectos"
    theme="dark"
    class="py-20 sm:py-28 border-t border-[#27272A]/70"
  >
    <div class="mb-12">
      <h2 class="font-display text-6xl sm:text-7xl lg:text-[5.5rem] font-bold uppercase tracking-tight leading-[0.9] text-[#F8FAFC]">
        Proyectos
      </h2>
    </div>
    <Projects />
  </Section>

  <!-- SECCIÓN 5: INTERESES / BEYOND CODE (Oscuro) 
  <Section
    id="Intereses"
    theme="dark"
    class="py-20 sm:py-24 border-t border-[#27272A]/70"
  >
    <div class="mb-10">
      <span class="block font-mono text-xs uppercase tracking-widest text-[#FACC15] mb-2">
        04 // BEYOND CODE
      </span>
      <h2 class="font-display text-6xl sm:text-7xl lg:text-[5.5rem] font-bold uppercase tracking-tight leading-[0.9] text-[#F8FAFC]">
        Intereses
      </h2>
    </div>
    <Intereses />
  </Section>-->

  <!-- SECCIÓN 6: CONTACTO (Oscuro #09090B) -->
  <Section
    id="Contacto"
    theme="dark"
    class="py-20 sm:py-28 border-t border-[#27272A]/70"
  >
    <Contacto />
  </Section>
</Layout>
