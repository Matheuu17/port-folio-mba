---
import CornerBracket from "./CornerBracket.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import Mail from "../icons/Mail.astro";

const CONTACT_LINKS = [
  {
    name: "GitHub",
    url: "https://github.com/Matheuu17",
    handle: "@Matheuu17",
    meta: "REPOSITORIOS & CÓDIGO",
    icon: GitHub,
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/matias-alcal%C3%A1/",
    handle: "in/matias-alcala",
    meta: "PERFIL PROFESIONAL",
    icon: LinkedIn,
  },
];

const EMAIL = "matiasalcala123456@gmail.com";
---

<div class="max-w-4xl mx-auto">
  <!-- Header Block -->
  <div class="flex flex-col items-start mb-10">
    <h2 class="font-display text-6xl sm:text-7xl lg:text-[5.5rem] font-bold uppercase tracking-tight leading-[0.9] text-[#F8FAFC]">
      HABLEMOS<span class="text-[#FACC15]" aria-hidden="true">.</span>
    </h2>

    <p class="mt-4 text-base sm:text-lg text-[#94A3B8] max-w-2xl leading-relaxed text-pretty">
      Abierto a todo tipo de propuestas, proyectos colaborativos o simplemente
      intercambiar ideas de desarrollo.
    </p>
  </div>

  <!-- Interactive Email Module -->
  <CornerBracket
    variant="dark"
    class="bg-[#111114] border border-[#27272A] p-5 sm:p-6 transition-colors duration-200"
  >
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-3.5 min-w-0">
        <div class="size-11 rounded-sm bg-[#09090B] border border-[#27272A] flex items-center justify-center text-[#FACC15] shrink-0">
          <Mail class="size-5" />
        </div>
        <div class="min-w-0">
          <span class="block font-mono text-[10px] uppercase tracking-widest text-[#94A3B8]">
            CORREO ELECTRÓNICO
          </span>
          <span
            id="contact-email"
            class="block font-mono text-sm sm:text-base font-medium text-[#F8FAFC] truncate select-all"
          >
            {EMAIL}
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <button
          id="copy-btn"
          type="button"
          class="px-4 py-2.5 rounded-sm border border-[#27272A] bg-[#09090B] hover:border-[#FACC15] hover:text-[#FACC15] font-mono text-xs uppercase tracking-wider font-semibold text-[#F8FAFC] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#111114] active:scale-[0.98] cursor-pointer"
          aria-label="Copiar correo electrónico"
        >
          Copiar
        </button>
        <a
          href={`mailto:${EMAIL}`}
          class="px-4 py-2.5 rounded-sm border border-[#FACC15] bg-[#FACC15] hover:bg-yellow-300 hover:border-yellow-300 font-mono text-xs uppercase tracking-wider font-semibold text-[#09090B] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#111114] active:scale-[0.98]"
        >
          Escribir ↗
        </a>
      </div>
    </div>

    <p
      id="copy-status"
      role="status"
      aria-live="polite"
      class="font-mono text-xs text-[#FACC15] font-medium mt-3 h-4 transition-opacity duration-200 opacity-0"
    >
      ✔ ¡Correo copiado al portapapeles!
    </p>
  </CornerBracket>

  <!-- Direct Social Links with Corner Brackets -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
    {CONTACT_LINKS.map(({ name, url, handle, meta, icon: IconComponent }) => (
      <CornerBracket
        as="a"
        variant="dark"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between gap-4 bg-[#111114] hover:bg-[#15151A] border border-[#27272A] p-4 sm:p-5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.99]"
      >
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="size-10 rounded-sm bg-[#09090B] border border-[#27272A] flex items-center justify-center text-[#F8FAFC] group-hover:text-[#FACC15] group-hover:border-[#FACC15]/50 transition-colors shrink-0">
            <IconComponent class="size-5" />
          </div>
          <div class="min-w-0">
            <span class="block font-mono text-[10px] uppercase tracking-widest text-[#94A3B8]">
              {meta}
            </span>
            <span class="block font-sans text-sm sm:text-base font-semibold text-[#F8FAFC] truncate">
              {name}{" "}
              <span class="font-mono text-xs font-normal text-[#94A3B8]">
                ({handle})
              </span>
            </span>
          </div>
        </div>
        <span
          aria-hidden="true"
          class="font-mono text-sm text-zinc-500 group-hover:text-[#FACC15] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"
        >
          ↗
        </span>
      </CornerBracket>
    ))}
  </div>
</div>

<script>
  const copyBtn = document.getElementById("copy-btn");
  const emailText = document
    .getElementById("contact-email")
    ?.textContent?.trim();
  const copyStatus = document.getElementById("copy-status");
  let resetTimer: number | undefined;

  async function copyToClipboard(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.position = "fixed";
    textArea.style.opacity = "0";
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    document.execCommand("copy");
    document.body.removeChild(textArea);
  }

  copyBtn?.addEventListener("click", async () => {
    if (!emailText) return;
    try {
      await copyToClipboard(emailText);
      const originalLabel = "Copiar";
      copyBtn.textContent = "Copiado!";
      copyBtn.classList.add(
        "border-[#FACC15]",
        "text-[#FACC15]",
        "bg-[#FACC15]/10",
      );
      copyStatus?.classList.remove("opacity-0");

      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        copyBtn.textContent = originalLabel;
        copyBtn.classList.remove(
          "border-[#FACC15]",
          "text-[#FACC15]",
          "bg-[#FACC15]/10",
        );
        copyStatus?.classList.add("opacity-0");
      }, 2400);
    } catch (err) {
      console.error("Error al copiar correo:", err);
    }
  });
</script>
