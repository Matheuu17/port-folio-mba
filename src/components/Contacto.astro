---
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import Mail from "../icons/Mail.astro";

const CONTACT_LINKS = [
  {
    name: "GitHub",
    url: "https://github.com/Matheuu17",
    handle: "@Matheuu17",
    icon: GitHub,
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/matias-alcal%C3%A1/", // Ajusta con tu link directo
    handle: "in/matias-alcala",
    icon: LinkedIn,
  },
];

const EMAIL = "matiasalcala123456@gmail.com"; 
---

<section id="contact" class="py-5 w-full">
 
  <div class="max-w-2xl mx-auto flex flex-col items-center border border-white/20 p-8 rounded-2xl bg-black/40 shadow-2xl">
    
    <!-- Prompt retro / Terminal status -->
    <div class="w-full flex items-center gap-2 pb-4 mb-6 border-b border-white/10 font-mono text-xs text-neutral-400">
      <span class="inline-block size-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-neutral-300">status:</span>
      <span class="text-emerald-300">disponible para oportunidades junior & pasantías</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold text-yellow-200 text-center mb-3 font-pixel">
      ¿Hablamos de un proyecto o rol técnico?
    </h3>
    
    <p class="text-sm md:text-base text-neutral-300 text-center mb-8 text-pretty leading-relaxed">
      Abierto a propuestas como Backend / Software Engineer Jr, proyectos colaborativos o simplemente intercambiar ideas de desarrollo.
    </p>

    <!-- Botón interactivo para copiar o escribir correo directo -->
    <div class="w-full mb-6">
      <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-[#0a0a0c] border border-white/15 hover:border-[#e12a88]/60 transition-colors">
        <div class="flex items-center gap-3 overflow-hidden">
          <Mail class="size-5 text-yellow-200 shrink-0" />
          <span id="contact-email" class="font-mono text-xs md:text-sm text-neutral-200 truncate select-all">
            {EMAIL}
          </span>
        </div>
        
        <div class="flex items-center gap-2">
          <button 
            id="copy-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-white/15 bg-white/5 hover:bg-white/10 text-xs font-mono text-neutral-300 hover:text-white transition-all active:scale-95 shrink-0"
            aria-label="Copiar correo electrónico"
          >
            Copiar
          </button>
          <a 
            href={`mailto:${EMAIL}`}
            class="px-3 py-1.5 rounded-lg border border-[#e12a88]/40 bg-[#e12a88]/10 hover:bg-[#e12a88]/20 text-xs font-mono text-white transition-all shrink-0"
          >
            Escribir
          </a>
        </div>
      </div>
      <p id="copy-status" class="text-center font-mono text-[11px] text-emerald-400 mt-2 h-4 transition-opacity opacity-0">
        ✔ ¡Correo copiado al portapapeles!
      </p>
    </div>

    <!-- Enlaces directos a redes -->
    <div class="flex flex-wrap justify-center gap-4 w-full pt-4 border-t border-white/10">
      {CONTACT_LINKS.map(({ name, url, handle, icon: IconComponent }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2.5 px-4 py-2 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/30 hover:bg-white/10 transition-all text-xs font-mono text-neutral-300 hover:text-white group"
        >
          <IconComponent class="size-4 text-neutral-400 group-hover:text-yellow-200 transition-colors" />
          <span>{name}: <span class="text-neutral-400 group-hover:text-neutral-200">{handle}</span></span>
        </a>
      ))}
    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const emailText = document.getElementById('contact-email')?.textContent?.trim();
  const copyStatus = document.getElementById('copy-status');

  copyBtn?.addEventListener('click', async () => {
    if (emailText) {
      try {
        await navigator.clipboard.writeText(emailText);
        if (copyStatus) {
          copyStatus.classList.remove('opacity-0');
          setTimeout(() => {
            copyStatus.classList.add('opacity-0');
          }, 2500);
        }
      } catch (err) {
        console.error('Error al copiar correo:', err);
      }
    }
  });
</script>