---
const SOCIALS = [
  { name: 'GitHub', href: 'https://github.com/Matheuu17' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/matias-alcal%C3%A1/' },
  { name: 'Instagram', href: 'https://www.instagram.com/matias_alcaba/' },
];
---

<footer class="w-full bg-[#09090B] border-t border-[#27272A]">
  <div class="w-full max-w-6xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="font-mono text-xs text-[#94A3B8] text-center sm:text-left">
      © 2026 <span class="text-[#F8FAFC]">Matías Alcalá</span>
      <span class="mx-2 text-zinc-600" aria-hidden="true">|</span>
      Built with Astro.
    </p>

    <ul class="flex flex-wrap items-center justify-center gap-6 font-mono text-xs uppercase tracking-widest">
      {SOCIALS.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#94A3B8] hover:text-[#FACC15] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] rounded-sm"
          >
            {social.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
