---
import Badge from "./Badge.astro";
import CornerBracket from "./CornerBracket.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import GitHubIcon from "../icons/GitHub.astro";
import MailIcon from "../icons/Mail.astro";
import CVIcon from "../icons/CV.astro";

const SUMMARY_METRICS = [
  { value: "4", label: "PROYECTOS" },
  { value: "3", label: "ÁREAS STACK" },
  { value: "TOP 20%", label: "QUINTO SUP." },
];
---

<section
  id="inicio"
  class="relative isolate min-h-screen w-full overflow-hidden flex flex-col justify-center bg-[#09090B] bg-blueprint-dark text-[#F8FAFC] scroll-mt-24 pt-28 pb-14 lg:pt-24 lg:pb-20"
>
  <div class="w-full max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-14 grid grid-cols-1 lg:grid-cols-12 items-center gap-10 lg:gap-8">
    <!-- COLUMNA IZQUIERDA (z-20, 4 cols): Identidad y Contacto -->
    <div class="relative z-20 lg:col-span-4 flex flex-col items-start">
      <!-- <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class="font-mono text-[11px] uppercase tracking-widest text-[#94A3B8]">
          00 // PORTAFOLIO
        </span>
        <a
          href="https://www.linkedin.com/in/matias-alcal%C3%A1/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B]"
        >
          <Badge>Disponible para trabajar</Badge>
        </a>
      </div>-->

      <h1 class="font-display text-6xl sm:text-7xl lg:text-[5.5rem] xl:text-[6.2rem] font-bold uppercase leading-[0.88] tracking-tight text-[#F8FAFC]">
        <span class="block">MATIAS</span>
        <span class="block">ALCALÁ</span>
      </h1>

      <!-- Lista vertical compacta de 3 datos -->
      <ul class="mt-6 space-y-2.5 font-mono text-xs uppercase tracking-wider text-[#94A3B8]">
        <li class="flex items-center gap-2.5">
          <svg
            class="size-3.5 text-[#FACC15] shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>LIMA, PERÚ</span>
        </li>

        <li class="flex items-center gap-2.5">
          <svg
            class="size-3.5 text-[#FACC15] shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span>ING. DE SOFTWARE — USIL</span>
        </li>

        <li class="flex items-center gap-2.5">
          <svg
            class="size-3.5 text-[#FACC15] shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>DATOS, FULLSTACK &amp; UX/UI</span>
        </li>
      </ul>

      <!-- Botones de acción compactos -->
      <nav
        aria-label="Acciones y enlaces principales"
        class="mt-7 flex flex-wrap items-center gap-2.5"
      >
        <a
          href="/CV - Matías Alcalá (Formato Harvard).pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-mono uppercase tracking-wider font-semibold bg-[#FACC15] text-[#09090B] border border-[#FACC15] rounded-sm hover:bg-yellow-300 hover:border-yellow-300 shadow-lg shadow-[#FACC15]/10 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.98]"
        >
          <CVIcon class="size-4 shrink-0" />
          <span>Descargar CV</span>
        </a>

        <a
          href="https://www.linkedin.com/in/matias-alcal%C3%A1/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de LinkedIn de Matías Alcalá"
          title="LinkedIn"
          class="inline-flex items-center justify-center size-10 bg-[#111114] text-[#F8FAFC] border border-[#27272A] rounded-sm hover:border-[#FACC15]/80 hover:text-[#FACC15] hover:bg-zinc-900 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.97]"
        >
          <LinkedInIcon class="size-4" />
        </a>

        <a
          href="https://github.com/Matheuu17"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de GitHub de Matías Alcalá"
          title="GitHub"
          class="inline-flex items-center justify-center size-10 bg-[#111114] text-[#F8FAFC] border border-[#27272A] rounded-sm hover:border-[#FACC15]/80 hover:text-[#FACC15] hover:bg-zinc-900 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.97]"
        >
          <GitHubIcon class="size-4" />
        </a>

        <a
          href="mailto:matiasalcala123456@gmail.com"
          aria-label="Enviar correo electrónico a Matías Alcalá"
          title="Email"
          class="inline-flex items-center justify-center size-10 bg-[#111114] text-[#F8FAFC] border border-[#27272A] rounded-sm hover:border-[#FACC15]/80 hover:text-[#FACC15] hover:bg-zinc-900 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.97]"
        >
          <MailIcon class="size-4" />
        </a>
      </nav>
    </div>

    <!-- RETRATO CENTRAL (Compensa el ~18% de margen transparente superior de matias1.webp) -->
    <div class="relative z-10 -mt-8 sm:-mt-10 lg:mt-0 lg:absolute lg:bottom-0 lg:left-1/2 lg:-translate-x-1/2 lg:z-10 flex justify-center pointer-events-none after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-24 after:bg-gradient-to-t after:from-[#09090B] after:to-transparent">
      <img
        src="/matias1.webp"
        alt="Retrato de Matías Alcalá"
        loading="eager"
        class="h-[66vh] sm:h-[76vh] lg:h-[105vh] max-h-[1100px] w-auto max-w-full lg:max-w-none object-contain object-bottom brightness-[1.06] contrast-[1.08] saturate-[1.05] select-none"
      />
    </div>

    <!-- COLUMNA DERECHA (z-20, minimalista y estrecha 270px sin cajas pesadas) -->
    <div class="relative z-20 lg:col-span-4 lg:col-start-9 w-full">
      <div class="w-full lg:w-[270px] lg:ml-auto flex flex-col gap-5">
        <!-- Bloque 1: ACTUALMENTE -->
        <CornerBracket class="bg-transparent p-3 transition-all duration-200">
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="font-mono text-[10px] uppercase tracking-widest text-[#FACC15]">
              ACTUALMENTE
            </span>
            <span class="inline-flex items-center gap-1 font-mono text-[9px] uppercase tracking-widest text-zinc-500">
              <span
                class="size-1.5 rounded-full bg-emerald-400"
                aria-hidden="true"
              ></span>
              EN CURSO
            </span>
          </div>
          <h2 class="font-display text-base sm:text-lg font-bold uppercase tracking-tight text-[#F8FAFC] leading-snug">
            INGENIERÍA DE SOFTWARE
          </h2>
          <p class="mt-0.5 text-xs text-[#94A3B8] leading-snug">
            Universidad San Ignacio de Loyola (8.º Ciclo)
          </p>
        </CornerBracket>

        <!-- Bloque 2: PROYECTO RECIENTE -->
        <CornerBracket class="bg-transparent p-3 transition-all duration-200">
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="font-mono text-[10px] uppercase tracking-widest text-[#FACC15]">
              PROYECTO RECIENTE
            </span>
            <span class="font-mono text-[9px] uppercase tracking-widest text-zinc-500">
              R&amp;D
            </span>
          </div>
          <h2 class="font-display text-base sm:text-lg font-bold uppercase tracking-tight text-[#F8FAFC] leading-snug">
            JARVIS // AGENTE IA
          </h2>
          <p class="mt-0.5 text-xs text-[#94A3B8] leading-snug">
            Python, Groq API &amp; Automatización
          </p>

          <!-- Línea SVG decorativa minimalista de telemetría -->
          <svg
            class="w-full h-4 mt-2.5 overflow-visible"
            viewBox="0 0 240 16"
            fill="none"
            aria-hidden="true"
          >
            <line
              x1="0"
              y1="11"
              x2="240"
              y2="11"
              stroke="#27272A"
              stroke-width="1"
              stroke-dasharray="3 3"
            />
            <path
              d="M0 11 L46 11 L58 3 L70 14 L84 7 L100 11 L160 11 L172 5 L186 11 L232 11"
              stroke="#FACC15"
              stroke-opacity="0.75"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="234" cy="11" r="2" fill="#FACC15" />
          </svg>
        </CornerBracket>

        <!-- Bloque 3: EN RESUMEN -->
        <CornerBracket class="bg-transparent p-3 transition-all duration-200">
          <span class="block font-mono text-[10px] uppercase tracking-widest text-[#FACC15] mb-2">
            EN RESUMEN
          </span>
          <dl class="grid grid-cols-3 gap-1.5 pt-2.5 border-t border-[#27272A]/70 text-center">
            {SUMMARY_METRICS.map((item, idx) => (
              <div class={idx > 0 ? "border-l border-[#27272A]/70 pl-1.5" : ""}>
                <dt class="font-display text-base sm:text-lg font-bold tracking-tight text-[#F8FAFC] leading-none">
                  {item.value}
                </dt>
                <dd class="mt-1 font-mono text-[8.5px] uppercase tracking-wider text-[#94A3B8] leading-tight">
                  {item.label}
                </dd>
              </div>
            ))}
          </dl>
        </CornerBracket>
      </div>
    </div>
  </div>

  <!-- ANCLAJES INFERIORES (En flujo limpio en móvil; esquinas inferior izq/der en desktop) -->
  <div class="relative z-20 w-full max-w-[1600px] mx-auto px-6 sm:px-10 mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 lg:contents">
    <!-- Esquina inferior izquierda: Etiqueta de rol -->
    <div class="flex items-center gap-2.5 lg:absolute lg:bottom-8 lg:left-14 lg:z-20">
      <span class="size-1.5 bg-[#FACC15] shrink-0" aria-hidden="true"></span>
      <span class="font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-zinc-400">
        INGENIERO DE SOFTWARE JR.
      </span>
    </div>

    <!-- Esquina inferior derecha: Botón compacto VER PROYECTOS -->
    <a
      href="#Proyectos"
      class="group inline-flex items-center gap-3 w-auto px-5 py-3 bg-transparent border border-[#27272A] rounded-sm font-mono text-xs uppercase tracking-widest text-[#F8FAFC] hover:border-[#FACC15] hover:text-[#FACC15] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.98] lg:absolute lg:bottom-8 lg:right-14 lg:z-20"
    >
      <span>VER PROYECTOS</span>
      <span
        aria-hidden="true"
        class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        ↗
      </span>
    </a>
  </div>
</section>
