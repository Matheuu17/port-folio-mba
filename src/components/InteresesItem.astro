---
export interface Props {
  name: string;
  icon: (_props: Record<string, any>) => any;
}

const { name, icon: IconComponent } = Astro.props;
---

<div class="group flex flex-col items-center justify-center gap-y-2.5 py-5 px-2 rounded-xl bg-[#0a0a0c] border border-white/10 hover:border-[#e12a88]/60 hover:bg-[#121217] transition-all duration-300 shadow-lg hover:shadow-[#e12a88]/10 hover:-translate-y-1">
  <div class="transition-transform duration-300 group-hover:scale-110">
    <IconComponent class="size-6 text-white" />
  </div>
  <span class="text-[10px] md:text-[11px] tracking-tight text-neutral-300 group-hover:text-white transition-colors text-center w-full block whitespace-nowrap overflow-hidden text-ellipsis">
    {name}
  </span>
</div>