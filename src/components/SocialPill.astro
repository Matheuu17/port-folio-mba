---
export interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'secondary',
  class: className = '',
  ...rest
} = Astro.props;

const isExternal = href.startsWith('http');
const variantStyles =
  variant === 'primary'
    ? 'bg-[#FACC15] text-[#09090B] border-[#FACC15] font-semibold hover:bg-yellow-300 hover:border-yellow-300 shadow-lg shadow-[#FACC15]/10'
    : 'bg-[#111114] text-[#F8FAFC] border-[#27272A] font-medium hover:border-[#FACC15]/70 hover:text-[#FACC15] hover:bg-zinc-900';
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class={`inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm border rounded-sm transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B] active:scale-[0.98] ${variantStyles} ${className}`}
  {...rest}
>
  <slot />
</a>
