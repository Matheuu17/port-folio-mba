---
import CornerBracket from './CornerBracket.astro';
import InteresesItem from './InteresesItem.astro';
import ProgrammingIcon from '../icons/Programming.astro';
import AIIcon from '../icons/AI.astro';
import JuegosIcon from '../icons/Juegos.astro';
import MusicaIcon from '../icons/Musica.astro';
import AprendizajeIcon from '../icons/Aprendizaje.astro';

const INTERESTS = [
  { name: 'Programación', code: '01', icon: ProgrammingIcon },
  { name: 'AI', code: '02', icon: AIIcon },
  { name: 'Juegos', code: '03', icon: JuegosIcon },
  { name: 'Música', code: '04', icon: MusicaIcon },
  { name: 'Aprendizaje', code: '05', icon: AprendizajeIcon },
];
---

<div class="space-y-6">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    {INTERESTS.map((interest) => (
      <InteresesItem {...interest} />
    ))}
  </div>

  <CornerBracket class="bg-[#111114] border border-[#27272A]/80 p-6 sm:p-7 transition-all duration-200 hover:bg-[#141419]">
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
      <div class="flex items-center gap-3 shrink-0">
        <span class="w-1 h-10 bg-[#FACC15] hidden sm:block" aria-hidden="true"></span>
        <div>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-[#FACC15]">
            BEYOND CODE // CULTURA
          </span>
          <span class="font-display text-lg uppercase tracking-tight text-[#F8FAFC] font-bold">
            Elenco de Danzas USIL
          </span>
        </div>
      </div>

      <p class="text-sm sm:text-base leading-relaxed text-[#94A3B8] sm:border-l sm:border-[#27272A] sm:pl-6 text-pretty">
        <strong class="text-[#F8FAFC] font-semibold">Danza Folclórica & Arte:</strong>{" "}Miembro activo del{" "}
        <span class="text-[#FACC15] font-semibold">Elenco de Danzas USIL</span> — disciplina, coordinación y sincronía en equipo fuera de la terminal.
      </p>
    </div>
  </CornerBracket>
</div>
