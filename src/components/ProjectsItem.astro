---
import CornerBracket from "./CornerBracket.astro";
import GitHub from "../icons/GitHub.astro";

export interface ProjectTag {
  name: string;
  icon?: (_props: Record<string, any>) => any;
  iconKey?: string;
}

export interface Props {
  id: string;
  code: string;
  urlLabel: string;
  statusBadge?: string;
  title: string;
  description: string;
  highlights: string[];
  github?: string;
  visualType?: "image" | "carousel" | "radar";
  coverImage?: string;
  hasGallery?: boolean;
  gallery?: { src: string; title: string }[];
  tags: ProjectTag[];
}

const {
  id,
  code,
  urlLabel,
  statusBadge,
  title,
  description,
  highlights,
  github,
  visualType = "image",
  coverImage = "",
  hasGallery = false,
  gallery = [],
  tags,
} = Astro.props;

const MONITORED_REGIONS = [
  { name: "TUMBES", x: 118, y: 54, alert: "ALTO" },
  { name: "PIURA", x: 108, y: 84, alert: "ALTO" },
  { name: "LAMBAYEQUE", x: 132, y: 114, alert: "MEDIO" },
  { name: "LIMA", x: 174, y: 168, alert: "MEDIO" },
  { name: "AREQUIPA", x: 226, y: 214, alert: "MODERADO" },
  { name: "PUNO", x: 274, y: 196, alert: "ALTO" },
];
---

<CornerBracket
  as="article"
  class="bg-[#111114] border border-[#27272A]/80 p-5 sm:p-8 transition-all duration-200 hover:bg-[#131318]"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 lg:gap-9 items-center">
    <!-- Visual Container: Carousel / Radar Map / Standard Image -->
    <div class="lg:col-span-6">
      {visualType === "carousel" && gallery.length > 0 ? (
        <div
          data-carousel
          class="rounded-sm overflow-hidden border border-[#27272A] bg-[#09090B] transition-colors duration-200 hover:border-[#FACC15]/50"
        >
          <!-- Browser Chrome -->
          <div class="flex items-center justify-between gap-2 px-3.5 py-2.5 bg-zinc-950 border-b border-[#27272A]">
            <div class="flex items-center gap-1.5 shrink-0" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-zinc-700"></span>
              <span class="size-2.5 rounded-full bg-zinc-700"></span>
              <span class="size-2.5 rounded-full bg-zinc-700"></span>
            </div>
            <span class="font-mono text-[10px] sm:text-[11px] text-zinc-400 truncate px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800/80">
              {urlLabel}
            </span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-[#FACC15] shrink-0">
              {gallery.length} vistas
            </span>
          </div>

          <!-- Interactive Viewport -->
          <div class="relative aspect-[16/10] w-full overflow-hidden bg-zinc-950 group/preview">
            {gallery.map((item, idx) => (
              <div
                data-carousel-slide
                data-slide-title={item.title}
                class={`absolute inset-0 transition-opacity duration-300 ${
                  idx === 0 ? "opacity-100 z-10" : "opacity-0 pointer-events-none"
                }`}
              >
                <img
                  src={item.src}
                  alt={item.title}
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                />
              </div>
            ))}

            <!-- Open Full Gallery Trigger -->
            <button
              type="button"
              data-open-modal={id}
              aria-label={`Ampliar galería de ${title}`}
              class="absolute inset-0 z-20 bg-[#09090B]/55 opacity-0 group-hover/preview:opacity-100 transition-opacity duration-200 flex items-center justify-center cursor-pointer focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#FACC15]"
            >
              <span class="font-mono text-xs uppercase tracking-widest px-3.5 py-2 bg-[#09090B]/90 border border-[#FACC15] text-[#FACC15]">
                Ampliar galería ↗
              </span>
            </button>
          </div>

          <!-- Carousel Controls Bar -->
          <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 bg-zinc-950 border-t border-[#27272A]">
            <span
              data-carousel-caption
              class="font-mono text-[10px] text-zinc-400 truncate max-w-[55%]"
            >
              {gallery[0].title}
            </span>

            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                data-carousel-prev
                aria-label="Vista anterior"
                class="size-6 inline-flex items-center justify-center rounded-sm bg-zinc-900 border border-[#27272A] text-zinc-400 hover:border-[#FACC15] hover:text-[#FACC15] font-mono text-xs transition-colors cursor-pointer"
              >
                ←
              </button>

              {gallery.map((_, idx) => (
                <button
                  type="button"
                  data-carousel-dot
                  aria-label={`Ver captura 0${idx + 1}`}
                  aria-pressed={idx === 0 ? "true" : "false"}
                  class={`px-1.5 h-6 inline-flex items-center justify-center rounded-sm border font-mono text-[10px] tracking-wider transition-colors cursor-pointer ${
                    idx === 0
                      ? "bg-[#FACC15] text-[#09090B] border-[#FACC15] font-semibold"
                      : "bg-zinc-900 text-zinc-400 border-[#27272A] hover:border-[#FACC15]/60 hover:text-zinc-200"
                  }`}
                >
                  0{idx + 1}
                </button>
              ))}

              <button
                type="button"
                data-carousel-next
                aria-label="Siguiente vista"
                class="size-6 inline-flex items-center justify-center rounded-sm bg-zinc-900 border border-[#27272A] text-zinc-400 hover:border-[#FACC15] hover:text-[#FACC15] font-mono text-xs transition-colors cursor-pointer"
              >
                →
              </button>
            </div>
          </div>
        </div>
      ) : visualType === "radar" ? (
        <button
          type="button"
          data-open-modal={id}
          aria-label={`Ver ficha técnica de ${title}`}
          class="group/preview block w-full text-left rounded-sm overflow-hidden border border-[#27272A] bg-[#09090B] transition-all duration-200 hover:border-[#FACC15]/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#111114] cursor-pointer"
        >
          <!-- Browser Chrome -->
          <div class="flex items-center justify-between gap-3 px-3.5 py-2.5 bg-zinc-950 border-b border-[#27272A]">
            <div class="flex items-center gap-1.5 shrink-0" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-zinc-700 group-hover/preview:bg-rose-400/80 transition-colors"></span>
              <span class="size-2.5 rounded-full bg-zinc-700 group-hover/preview:bg-amber-400/80 transition-colors"></span>
              <span class="size-2.5 rounded-full bg-zinc-700 group-hover/preview:bg-emerald-400/80 transition-colors"></span>
            </div>
            <span class="font-mono text-[10px] sm:text-[11px] text-zinc-400 truncate px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800/80">
              {urlLabel}
            </span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-amber-400 shrink-0">
              MVP
            </span>
          </div>

          <!-- Technical Geospatial Radar Visual -->
          <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#09090B] p-4 flex flex-col justify-between">
            <CornerBracket class="w-full h-full flex flex-col justify-between p-3.5 bg-zinc-950/70">
              <!-- Top HUD -->
              <div class="relative z-10 flex items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-[#FACC15]">
                  <span class="size-1.5 rounded-full bg-[#FACC15] animate-pulse" aria-hidden="true"></span>
                  PREVIEW // MAPA INTERACTIVO
                </span>
                <span class="font-mono text-[10px] text-zinc-500">
                  PERÚ • 2011–2026
                </span>
              </div>

              <!-- Radar & Geo Nodes SVG -->
              <svg
                class="absolute inset-0 w-full h-full pointer-events-none"
                viewBox="0 0 400 250"
                fill="none"
                aria-hidden="true"
              >
                <!-- Subtle coordinate grid -->
                <path
                  d="M0 62.5 H400 M0 125 H400 M0 187.5 H400 M80 0 V250 M160 0 V250 M240 0 V250 M320 0 V250"
                  stroke="#27272A"
                  stroke-opacity="0.45"
                  stroke-width="0.75"
                />
                <!-- Concentric radar rings -->
                <circle cx="195" cy="132" r="38" stroke="#3F3F46" stroke-dasharray="3 3" stroke-width="0.9" />
                <circle cx="195" cy="132" r="76" stroke="#3F3F46" stroke-dasharray="3 4" stroke-width="0.9" />
                <circle cx="195" cy="132" r="114" stroke="#27272A" stroke-width="0.9" />
                <!-- Radar sweep wedge -->
                <path
                  d="M195 132 L112 52 A114 114 0 0 1 195 18 Z"
                  fill="#FACC15"
                  fill-opacity="0.07"
                />
                <line x1="195" y1="132" x2="112" y2="52" stroke="#FACC15" stroke-opacity="0.45" stroke-width="1" />

                <!-- Connecting coastal monitoring polyline -->
                <polyline
                  points="118,54 108,84 132,114 174,168 226,214 274,196"
                  stroke="#FACC15"
                  stroke-opacity="0.35"
                  stroke-width="1.2"
                  stroke-dasharray="4 3"
                />

                <!-- Monitored Peruvian regions -->
                {MONITORED_REGIONS.map((reg) => (
                  <g>
                    <circle
                      cx={reg.x}
                      cy={reg.y}
                      r={reg.alert === "ALTO" ? "9" : "6"}
                      fill={reg.alert === "ALTO" ? "#FACC15" : "#38BDF8"}
                      fill-opacity="0.16"
                    />
                    <circle
                      cx={reg.x}
                      cy={reg.y}
                      r="3"
                      fill={reg.alert === "ALTO" ? "#FACC15" : "#38BDF8"}
                    />
                    <text
                      x={reg.x + 8}
                      y={reg.y + 3}
                      fill="#94A3B8"
                      font-size="7.5"
                      font-family="monospace"
                      letter-spacing="0.08em"
                    >
                      {reg.name}
                    </text>
                  </g>
                ))}
              </svg>

              <!-- Bottom Telemetry Legend -->
              <div class="relative z-10 flex items-center justify-between gap-2 pt-2 border-t border-[#27272A]/80">
                <span class="font-mono text-[9.5px] uppercase tracking-wider text-zinc-400">
                  NOAA / ENFEN • 6 REGIONES ACTIVAS
                </span>
                <span class="font-mono text-[9.5px] uppercase tracking-wider text-[#FACC15] group-hover/preview:underline">
                  Ver ficha ↗
                </span>
              </div>
            </CornerBracket>
          </div>
        </button>
      ) : (
        <button
          type="button"
          data-open-modal={id}
          aria-label={
            hasGallery ? `Abrir galería de ${title}` : `Ver detalles de ${title}`
          }
          class="group/preview block w-full text-left rounded-sm overflow-hidden border border-[#27272A] bg-[#09090B] transition-all duration-200 hover:border-[#FACC15]/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#111114] cursor-pointer"
        >
          <!-- Browser Chrome -->
          <div class="flex items-center justify-between gap-3 px-3.5 py-2.5 bg-zinc-950 border-b border-[#27272A]">
            <div class="flex items-center gap-1.5 shrink-0" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-zinc-700 group-hover/preview:bg-rose-400/80 transition-colors"></span>
              <span class="size-2.5 rounded-full bg-zinc-700 group-hover/preview:bg-amber-400/80 transition-colors"></span>
              <span class="size-2.5 rounded-full bg-zinc-700 group-hover/preview:bg-emerald-400/80 transition-colors"></span>
            </div>
            <span class="font-mono text-[10px] sm:text-[11px] text-zinc-400 truncate px-2.5 py-0.5 rounded bg-zinc-900 border border-zinc-800/80">
              {urlLabel}
            </span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-[#FACC15] shrink-0">
              {hasGallery ? `${gallery.length} vistas` : "preview"}
            </span>
          </div>

          <!-- Viewport -->
          <div class="relative aspect-[16/10] w-full overflow-hidden bg-zinc-950">
            <img
              src={coverImage}
              alt={`Captura de pantalla de ${title}`}
              class="w-full h-full object-cover object-top transition-transform duration-300 group-hover/preview:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-[#09090B]/60 opacity-0 group-hover/preview:opacity-100 transition-opacity duration-200 flex items-center justify-center">
              <span class="font-mono text-xs uppercase tracking-widest px-3.5 py-2 bg-[#09090B]/90 border border-[#FACC15] text-[#FACC15]">
                {hasGallery ? "Explorar galería ↗" : "Ver detalles ↗"}
              </span>
            </div>
          </div>
        </button>
      )}
    </div>

    <!-- Project Details -->
    <div class="lg:col-span-6 flex flex-col justify-between">
      <div>
        {statusBadge && (
          <div class="mb-3">
            <span class="inline-flex items-center gap-2 font-mono text-[10px] sm:text-[11px] uppercase tracking-widest px-2.5 py-1 rounded-sm bg-amber-400/10 text-[#FACC15] border border-[#FACC15]/40 font-semibold">
              <span class="size-1.5 rounded-full bg-[#FACC15] animate-pulse" aria-hidden="true"></span>
              {statusBadge}
            </span>
          </div>
        )}

        <h3 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[#F8FAFC] leading-tight">
          {title}
        </h3>

        <p class="mt-3 text-sm sm:text-base text-[#94A3B8] leading-relaxed text-pretty">
          {description}
        </p>

        <ul class="mt-5 space-y-2.5">
          {highlights.map((point) => (
            <li class="flex items-start gap-2.5 text-sm text-zinc-200 leading-relaxed">
              <span
                class="mt-2 size-1.5 bg-[#FACC15] shrink-0"
                aria-hidden="true"
              ></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Stack & Actions -->
      <div class="mt-6 pt-5 border-t border-[#27272A] space-y-5">
        <ul
          class="flex flex-wrap gap-2"
          aria-label={`Tecnologías usadas en ${title}`}
        >
          {tags.map((tag) => (
            <li>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-sm bg-zinc-950 border border-[#27272A] font-mono text-[11px] uppercase tracking-wider text-zinc-300">
                {tag.icon && <tag.icon class="size-3.5 shrink-0" />}

                {tag.iconKey === "nextjs" && (
                  <svg class="size-3.5 shrink-0 text-[#F8FAFC]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9 15V9l6.5 8.5" />
                    <path d="M15 9v4" />
                  </svg>
                )}

                {tag.iconKey === "supabase" && (
                  <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M13.35 21.38c-.55.69-1.66.31-1.67-.58l-.19-12.9h8.62c1.56 0 2.43 1.8 1.46 3.02l-8.22 10.46Z" fill="#3ECF8E" />
                    <path d="M10.65 2.62c.55-.69 1.66-.31 1.67.58l.19 12.9H3.89c-1.56 0-2.43-1.8-1.46-3.02L10.65 2.62Z" fill="#3ECF8E" fill-opacity="0.7" />
                  </svg>
                )}

                {tag.iconKey === "sheets" && (
                  <svg class="size-3.5 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M3 9h18M3 15h18M9 3v18" />
                  </svg>
                )}

                {tag.iconKey === "leaflet" && (
                  <svg class="size-3.5 shrink-0 text-lime-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                  </svg>
                )}

                {tag.iconKey === "js" && (
                  <svg class="size-3.5 shrink-0 text-[#FACC15]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M10 10v5a2 2 0 0 1-2 2" />
                    <path d="M14 15.5c.5.7 1.2 1 2 1 1.2 0 2-.6 2-1.5 0-1-.8-1.4-2-1.7-1.1-.3-1.8-.8-1.8-1.6 0-.9.8-1.5 1.8-1.5.8 0 1.4.3 1.8.8" />
                  </svg>
                )}

                {tag.iconKey === "python" && (
                  <svg class="size-3.5 shrink-0 text-[#FACC15]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3c-2.5 0-4 1-4 3v2h5v1H7c-2 0-3 1.5-3 4s1 4 3 4h2v-2.5c0-1.5 1-2.5 2.5-2.5h4c1.5 0 2.5-1 2.5-2.5V6c0-2-1.5-3-4-3z" />
                    <path d="M12 21c2.5 0 4-1 4-3v-2h-5v-1h6c2 0 3-1.5 3-4s-1-4-3-4h-2v2.5c0 1.5-1 2.5-2.5 2.5h-4C7 12 6 13 6 14.5V18c0 2 1.5 3 4 3z" />
                  </svg>
                )}

                {tag.iconKey === "noaa" && (
                  <svg class="size-3.5 shrink-0 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3.6 9h16.8M3.6 15h16.8" />
                    <path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
                  </svg>
                )}

                {tag.name}
              </span>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap items-center gap-3">
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-mono uppercase tracking-wider bg-[#FACC15] text-[#09090B] font-semibold border border-[#FACC15] rounded-sm hover:bg-yellow-300 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#111114] active:scale-[0.98]"
            >
              <GitHub class="size-4 shrink-0" />
              <span>Código (GitHub)</span>
              <span aria-hidden="true">↗</span>
            </a>
          )}

          <button
            type="button"
            data-open-modal={id}
            class={`inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-mono uppercase tracking-wider rounded-sm transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] focus-visible:ring-offset-2 focus-visible:ring-offset-[#111114] active:scale-[0.98] cursor-pointer ${
              !github
                ? "bg-[#FACC15] text-[#09090B] font-semibold border border-[#FACC15] hover:bg-yellow-300"
                : "bg-zinc-950 text-[#F8FAFC] border border-[#27272A] hover:border-[#FACC15] hover:text-[#FACC15]"
            }`}
          >
            <span>{hasGallery ? "Demo / Galería" : "Demo / Detalles"}</span>
            <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Editorial Modal (Gallery / Technical Details) -->
  <dialog
    id={id}
    aria-labelledby={`${id}-title`}
    class="backdrop:bg-[#09090B]/90 backdrop:backdrop-blur-md bg-[#111114] border border-[#27272A] max-w-5xl w-[92vw] p-5 sm:p-7 text-[#F8FAFC] m-auto shadow-2xl"
  >
    <div class="flex items-start sm:items-center justify-between gap-4 border-b border-[#27272A] pb-4 mb-6">
      <div>
        <span class="block font-mono text-[11px] uppercase tracking-widest text-[#FACC15]">
          {hasGallery
            ? `${code} // GALERÍA DE INTERFACES`
            : `${code} // FICHA TÉCNICA`}
        </span>
        <h4
          id={`${id}-title`}
          class="font-display text-xl sm:text-2xl font-bold uppercase tracking-tight text-[#F8FAFC] mt-1"
        >
          {title}
        </h4>
      </div>
      <button
        type="button"
        aria-label="Cerrar ventana"
        class="close-modal font-mono text-xs uppercase tracking-widest text-zinc-300 hover:text-[#FACC15] px-3 py-1.5 border border-[#27272A] hover:border-[#FACC15] bg-[#09090B] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FACC15] cursor-pointer shrink-0"
      >
        Cerrar [ESC]
      </button>
    </div>

    {hasGallery ? (
      <div class="editorial-scroll grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[72vh] overflow-y-auto pr-1">
        {gallery.map((item, index) => (
          <figure class="flex flex-col gap-2.5 border border-[#27272A] p-3 bg-[#09090B]">
            <img
              src={item.src}
              alt={item.title}
              class="w-full h-auto border border-zinc-800/80 object-cover"
              loading="lazy"
            />
            <figcaption class="font-mono text-xs text-zinc-300">
              <span class="text-[#FACC15] mr-1.5">0{index + 1}.</span>
              {item.title}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="editorial-scroll grid grid-cols-1 md:grid-cols-12 gap-6 max-h-[72vh] overflow-y-auto pr-1 items-start">
        <div class="md:col-span-7 border border-[#27272A] bg-[#09090B] p-3">
          {visualType === "radar" ? (
            <div class="relative aspect-[16/10] w-full flex flex-col justify-between p-4 bg-zinc-950">
              <span class="font-mono text-[10px] uppercase tracking-widest text-[#FACC15]">
                EN DESARROLLO // ARQUITECTURA GEODATA
              </span>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 my-4">
                {MONITORED_REGIONS.map((reg) => (
                  <div class="p-2.5 border border-[#27272A] bg-[#09090B]">
                    <span class="block font-mono text-[10px] text-zinc-400">{reg.name}</span>
                    <span class={`font-mono text-xs font-semibold ${reg.alert === "ALTO" ? "text-[#FACC15]" : "text-sky-400"}`}>
                      RIESGO {reg.alert}
                    </span>
                  </div>
                ))}
              </div>
              <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-500">
                SERIES HISTÓRICAS NOAA &amp; ENFEN (2011–2026)
              </span>
            </div>
          ) : (
            <img
              src={coverImage}
              alt={`Vista completa de ${title}`}
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          )}
        </div>
        <div class="md:col-span-5 flex flex-col gap-4">
          <p class="text-sm text-[#94A3B8] leading-relaxed">{description}</p>
          <div>
            <span class="block font-mono text-[11px] uppercase tracking-widest text-[#FACC15] mb-2">
              Aspectos Técnicos
            </span>
            <ul class="space-y-2">
              {highlights.map((point) => (
                <li class="flex items-start gap-2 text-sm text-zinc-200 leading-relaxed">
                  <span
                    class="mt-2 size-1.5 bg-[#FACC15] shrink-0"
                    aria-hidden="true"
                  ></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-mono uppercase tracking-wider bg-[#FACC15] text-[#09090B] font-semibold hover:bg-yellow-300 transition-all duration-200"
            >
              <GitHub class="size-4" />
              <span>Explorar repositorio en GitHub ↗</span>
            </a>
          )}
        </div>
      </div>
    )}
  </dialog>
</CornerBracket>
