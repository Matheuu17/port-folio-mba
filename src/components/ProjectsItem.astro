---
import GitHub from "../icons/GitHub.astro";

export interface Props {
  id: string;
  title: string;
  description: string;
  highlights: string[];
  github?: string;
  coverImage: string;
  hasGallery?: boolean;
  gallery?: { src: string; title: string }[];
  tags: { name: string; class: string; icon: (_props: Record<string, any>) => any }[];
}

const {
  id,
  title,
  description,
  highlights,
  github,
  coverImage,
  hasGallery = false,
  gallery = [],
  tags,
} = Astro.props;
---

<article class="relative grid grid-cols-1 md:grid-cols-2 gap-8 items-center border border-white/20 p-6 md:p-8 rounded-2xl bg-black/40">
  <!-- Imagen -->
  <div 
    class={`relative overflow-hidden rounded-xl border border-white/20 ${hasGallery ? 'group cursor-pointer' : ''}`}
    data-open-modal={hasGallery ? id : undefined}
  >
    <img 
      src={coverImage} 
      alt={`Captura de ${title}`} 
      class={`w-full h-auto object-cover transition-transform duration-300 ${hasGallery ? 'group-hover:scale-105' : ''}`} 
      loading="lazy"
    />
    {hasGallery && (
      <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center gap-2 text-yellow-200 text-xs">
        <span>▶ [ CLICK PARA VER GALERÍA ]</span>
      </div>
    )}
  </div>

  <!-- Detalles -->
  <div class="flex flex-col justify-between">
    <div>
      <div class="flex items-start justify-between gap-3 mb-4">
        <h3 class="text-2xl font-bold text-yellow-200 tracking-wide leading-tight">
          {title}
        </h3>
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${title} en GitHub`}
            class="text-white hover:text-orange-400 transition-colors p-1 shrink-0"
          >
            <GitHub class="size-7" />
          </a>
        )}
      </div>

      <p class="text-base text-white leading-relaxed mb-4 text-pretty">
        {description}
      </p>

      <ul class="space-y-2 mb-6">
        {highlights.map((point) => (
          <li class="flex items-start gap-2 text-sm text-neutral-200 leading-normal">
            <span class="text-orange-500 font-bold mt-0.5">▶</span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Tags -->
    <ul class="flex flex-wrap gap-2 pt-2">
      {tags.map((tag) => (
        <li>
          <span class={`flex items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-3`}>
            <tag.icon class="size-3.5" />
            {tag.name}
          </span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Modal -->
  {hasGallery && (
    <dialog 
      id={id} 
      class="backdrop:bg-black/90 backdrop:backdrop-blur-sm bg-neutral-950 border border-white/20 rounded-2xl max-w-5xl w-[92vw] p-6 text-white m-auto shadow-2xl"
    >
      <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
        <h4 class="text-lg text-yellow-200">{title} — Galería</h4>
        <button class="close-modal text-orange-400 hover:text-white text-xs px-3 py-1.5 border border-white/20 rounded hover:bg-white/10 transition">
          [ X CERRAR / ESC ]
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[75vh] overflow-y-auto pr-2">
        {gallery.map((item, index) => (
          <div class="flex flex-col gap-2 border border-white/10 rounded-lg p-2 bg-black/60">
            <img 
              src={item.src} 
              alt={item.title} 
              class="w-full h-auto rounded border border-white/10 object-cover" 
              loading="lazy" 
            />
            <span class="text-xs text-yellow-100">0{index + 1}. {item.title}</span>
          </div>
        ))}
      </div>
    </dialog>
  )}
</article>