<div 
  id="intro-presentation" 
  class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-950 text-white transition-transform duration-1000 ease-in-out translate-y-0"
>
  <div class="text-center space-y-4">
    <!-- Mantenemos las etiquetas con una altura mínima para evitar saltos en la pantalla mientras se "teclean" -->
    <h1 id="typewriter-title" class="text-2xl md:text-4xl font-bold tracking-wider font-mono min-h-[40px]">
      <!-- Se llenará dinámicamente -->
    </h1>
    <p id="typewriter-subtitle" class="text-neutral-400 text-xs md:text-sm tracking-widest uppercase font-mono min-h-[20px]">
      <!-- Se llenará dinámicamente -->
    </p>
  </div>
</div>

<script>
  // Textos que vamos a separar por palabras
  const titleText = "WELCOME TO MY PORTFOLIO";
  const subtitleText = "miportafolio.com";

  const titleElement = document.getElementById('typewriter-title');
  const subtitleElement = document.getElementById('typewriter-subtitle');
  const intro = document.getElementById('intro-presentation');

  // Función para simular el teclado palabra por palabra
  function typeWords(element, text, speed) {
    return new Promise((resolve) => {
      const words = text.split(" "); 
      let index = 0;

      function type() {
        if (index < words.length) {
          // Añade la palabra y un espacio al final
          element.innerHTML += words[index] + " ";
          index++;
          setTimeout(type, speed); // Espera antes de pasar a la sigueinte palabra
        } else {
          resolve(); // Termina el texto
        }
      }
      type();
    });
  }

  // Ejecución secuencial al cargar el DOM
  window.addEventListener('DOMContentLoaded', async () => {
    if (titleElement) await typeWords(titleElement, titleText, 350);
    await new Promise(resolve => setTimeout(resolve, 300));
    if (subtitleElement) await typeWords(subtitleElement, subtitleText, 380);
    setTimeout(() => {
      if (intro) {
        intro.classList.remove('translate-y-0');
        intro.classList.add('-translate-y-full');
      }
    }, 500);
  });
</script>