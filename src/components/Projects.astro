---

<div class="flex flex-col gap-y-10">
  {PROJECTS.map((project) => (
    <ProjectItem {...project} />
  ))}
</div>

<script>
  // Modales de galería y ficha técnica
  document.querySelectorAll("[data-open-modal]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const modalId = trigger.getAttribute("data-open-modal");
      if (modalId) {
        const modal = document.getElementById(
          modalId,
        ) as HTMLDialogElement | null;
        if (modal) modal.showModal();
      }
    });
  });

  document.querySelectorAll("dialog .close-modal").forEach((button) => {
    button.addEventListener("click", (e) => {
      const modal = (e.target as HTMLElement).closest("dialog");
      if (modal) modal.close();
    });
  });

  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });

  // Selector interactivo de vistas (carrusel en mockup de navegador)
  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((carousel) => {
      const slides = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
      );
      const dots = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
      );
      const prevBtn = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-prev]",
      );
      const nextBtn = carousel.querySelector<HTMLButtonElement>(
        "[data-carousel-next]",
      );
      const captionEl = carousel.querySelector<HTMLElement>(
        "[data-carousel-caption]",
      );
      let activeIndex = 0;

      function updateSlide(nextIdx: number) {
        if (slides.length === 0) return;
        activeIndex = (nextIdx + slides.length) % slides.length;

        slides.forEach((slide, idx) => {
          const isCurrent = idx === activeIndex;
          slide.classList.toggle("opacity-100", isCurrent);
          slide.classList.toggle("z-10", isCurrent);
          slide.classList.toggle("opacity-0", !isCurrent);
          slide.classList.toggle("pointer-events-none", !isCurrent);
        });

        dots.forEach((dot, idx) => {
          const isCurrent = idx === activeIndex;
          dot.classList.toggle("bg-[#FACC15]", isCurrent);
          dot.classList.toggle("text-[#09090B]", isCurrent);
          dot.classList.toggle("border-[#FACC15]", isCurrent);
          dot.classList.toggle("font-semibold", isCurrent);
          dot.classList.toggle("bg-zinc-900", !isCurrent);
          dot.classList.toggle("text-zinc-400", !isCurrent);
          dot.classList.toggle("border-[#27272A]", !isCurrent);
          dot.setAttribute("aria-pressed", String(isCurrent));
        });

        const activeTitle =
          slides[activeIndex]?.getAttribute("data-slide-title");
        if (captionEl && activeTitle) {
          captionEl.textContent = activeTitle;
        }
      }

      dots.forEach((dot, idx) => {
        dot.addEventListener("click", () => updateSlide(idx));
      });

      prevBtn?.addEventListener("click", () => updateSlide(activeIndex - 1));
      nextBtn?.addEventListener("click", () => updateSlide(activeIndex + 1));
    });
</script>
