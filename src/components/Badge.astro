---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  class={`inline-flex items-center gap-2 font-mono text-[11px] sm:text-xs uppercase tracking-widest bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 rounded-full px-3 py-1 transition-all duration-200 hover:border-emerald-400/60 hover:bg-emerald-500/15 ${className}`}
>
  <span class="relative flex size-2" aria-hidden="true">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
    <span class="relative inline-flex rounded-full size-2 bg-emerald-400"></span>
  </span>
  <slot />
</span>
