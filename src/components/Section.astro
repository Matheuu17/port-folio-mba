---
export interface Props {
  id?: string;
  class?: string;
  containerClass?: string;
  theme?: "dark" | "light";
}

const {
  id,
  class: className = "",
  containerClass = "",
  theme = "dark",
} = Astro.props;

const themeStyles =
  theme === "light"
    ? "bg-blueprint-light text-[#0B1120] border-y border-slate-300/80"
    : "text-[#F8FAFC]";
---

<section id={id} class={`w-full scroll-mt-24 ${themeStyles} ${className}`}>
  <div class={`w-full max-w-6xl mx-auto px-5 sm:px-8 ${containerClass}`}>
    <slot />
  </div>
</section>
